{
  "name": "opinion-map-backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Opinion Map のバックエンドAPI（イベント・セッション・投稿）",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "oxlint && tsc --noEmit",
    "test": "vitest run && TEST_REPOS=dynamo vitest run",
    "build": "tsc -p tsconfig.build.json",
    "bundle": "esbuild src/handler.ts --bundle --platform=node --target=node22 --format=esm --minify --sourcemap --outfile=dist-lambda/handler.mjs --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\"",
    "dev": "tsx src/localServer.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "esbuild": "^0.25.12",
    "osls": "^4.4.0",
    "oxlint": "^0.15.15",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1156.0",
    "@aws-sdk/client-ecs": "^3.1156.0",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/lib-dynamodb": "^3.1156.0"
  }
}
